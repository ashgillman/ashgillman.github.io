{
  "@context": [
    "https://schema.org",
    {
      "flow": "https://ashgillman.github.io/ns/recipe-flow#"
    }
  ],
  "@type": "Recipe",
  "name": "Sourdough pancakes",
  "recipeIngredient": [
    {
      "@type": "PropertyValue",
      "@id": "#oats",
      "name": "170 g oats"
    },
    {
      "@type": "PropertyValue",
      "@id": "#soy-milk",
      "name": "490 g soy milk"
    },
    {
      "@type": "PropertyValue",
      "@id": "#oil",
      "name": "35 g oil"
    },
    {
      "@type": "PropertyValue",
      "@id": "#equal",
      "name": "7 sachets Equal"
    },
    {
      "@type": "PropertyValue",
      "@id": "#sugar",
      "name": "3 tbsp sugar"
    },
    {
      "@type": "PropertyValue",
      "@id": "#cinnamon",
      "name": "Cinnamon"
    },
    {
      "@type": "PropertyValue",
      "@id": "#vanilla",
      "name": "Vanilla essence"
    },
    {
      "@type": "PropertyValue",
      "@id": "#starter",
      "name": "~50 g sourdough starter"
    },
    {
      "@type": "PropertyValue",
      "@id": "#plain-flour",
      "name": "240 g plain flour"
    },
    {
      "@type": "PropertyValue",
      "@id": "#baking-soda",
      "name": "1–2 tsp baking soda"
    }
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "name": "Soak oats",
      "text": [
        "Combine oats and soy milk; let sit."
      ],
      "@id": "#soak",
      "flow:timing": "Day 1",
      "flow:inputs": [
        {
          "@id": "#oats"
        },
        {
          "@id": "#soy-milk"
        }
      ],
      "flow:output": {
        "@id": "#soaked-oats"
      }
    },
    {
      "@type": "HowToStep",
      "name": "Mix batter",
      "text": [
        "Mix oil, Equal, sugar, cinnamon, vanilla and starter into the soaked oats."
      ],
      "@id": "#mix",
      "flow:inputs": [
        {
          "@id": "#soaked-oats"
        },
        {
          "@id": "#oil"
        },
        {
          "@id": "#equal"
        },
        {
          "@id": "#sugar"
        },
        {
          "@id": "#cinnamon"
        },
        {
          "@id": "#vanilla"
        },
        {
          "@id": "#starter"
        }
      ],
      "flow:output": {
        "@id": "#batter"
      }
    },
    {
      "@type": "HowToStep",
      "name": "Add flour",
      "text": [
        "Mix in plain flour."
      ],
      "@id": "#add-flour",
      "flow:inputs": [
        {
          "@id": "#batter"
        },
        {
          "@id": "#plain-flour"
        }
      ],
      "flow:output": {
        "@id": "#flour-batter"
      }
    },
    {
      "@type": "HowToStep",
      "name": "Rest",
      "text": [
        "Cover and leave overnight."
      ],
      "@id": "#ferment",
      "flow:timing": "Overnight",
      "flow:inputs": [
        {
          "@id": "#flour-batter"
        }
      ],
      "flow:output": {
        "@id": "#overnight-batter"
      }
    },
    {
      "@type": "HowToStep",
      "name": "Add baking soda",
      "text": [
        "Add ~1–2 tsp baking soda slowly, until lightly bubbling."
      ],
      "@id": "#add-soda",
      "flow:timing": "Day 2",
      "flow:inputs": [
        {
          "@id": "#overnight-batter"
        },
        {
          "@id": "#baking-soda"
        }
      ],
      "flow:output": {
        "@id": "#finished-batter"
      }
    },
    {
      "@type": "HowToStep",
      "name": "Cook",
      "text": [
        "Cook pancakes in a hot, lightly oiled pan."
      ],
      "@id": "#cook",
      "flow:timing": "Day 2",
      "flow:inputs": [
        {
          "@id": "#finished-batter"
        }
      ],
      "flow:output": {
        "@id": "#pancakes"
      }
    }
  ]
}
