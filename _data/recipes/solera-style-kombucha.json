{
  "@context": [
    "https://schema.org",
    {
      "flow": "https://ashgillman.github.io/ns/recipe-flow#"
    }
  ],
  "@type": "Recipe",
  "name": "Kombucha",
  "recipeIngredient": [
    {
      "@type": "PropertyValue",
      "@id": "#fermented-kombucha",
      "name": "About 920 mL fermented kombucha (two bottles)"
    },
    {
      "@type": "PropertyValue",
      "@id": "#water",
      "name": "1 L boiling water"
    },
    {
      "@type": "PropertyValue",
      "@id": "#sugar",
      "name": "100 g sugar"
    },
    {
      "@type": "PropertyValue",
      "@id": "#tea",
      "name": "10 g tea"
    },
    {
      "@type": "PropertyValue",
      "@id": "#molasses",
      "name": "1 tbsp molasses or treacle"
    }
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "name": "Brew sweet tea",
      "text": [
        "Steep until cool."
      ],
      "@id": "#brew",
      "flow:inputs": [
        {
          "@id": "#water"
        },
        {
          "@id": "#sugar"
        },
        {
          "@id": "#tea"
        },
        {
          "@id": "#molasses"
        }
      ],
      "flow:output": {
        "@id": "#sweet-tea"
      }
    },
    {
      "@type": "HowToStep",
      "name": "Prime and bottle",
      "text": [
        "For each of two 500 mL bottles, use 40 g cooled sweet tea and about 460 mL fermented kombucha."
      ],
      "@id": "#bottle",
      "flow:inputs": [
        {
          "@id": "#sweet-tea"
        },
        {
          "@id": "#fermented-kombucha"
        }
      ],
      "flow:output": {
        "@id": "#bottled-kombucha"
      }
    },
    {
      "@type": "HowToStep",
      "name": "Refill bulk fermentation jar",
      "text": [
        "Use the remaining sweet tea."
      ],
      "@id": "#refill",
      "flow:inputs": [
        {
          "@id": "#sweet-tea"
        }
      ],
      "flow:output": {
        "@id": "#refilled-jar"
      }
    }
  ]
}
