{
  "@context": [
    "https://schema.org",
    {
      "flow": "https://ashgillman.github.io/ns/recipe-flow#"
    }
  ],
  "@type": "Recipe",
  "name": "Hybrid sourdough doughnuts",
  "recipeYield": "15 doughnuts",
  "recipeIngredient": [
    {
      "@type": "PropertyValue",
      "@id": "#bread-flour",
      "name": "500 g bread flour"
    },
    {
      "@type": "PropertyValue",
      "@id": "#starter",
      "name": "120 g sourdough starter (100% hydration)"
    },
    {
      "@type": "PropertyValue",
      "@id": "#milk",
      "name": "180 g milk"
    },
    {
      "@type": "PropertyValue",
      "@id": "#eggs",
      "name": "2 eggs"
    },
    {
      "@type": "PropertyValue",
      "@id": "#sugar",
      "name": "60 g sugar"
    },
    {
      "@type": "PropertyValue",
      "@id": "#salt",
      "name": "8 g salt"
    },
    {
      "@type": "PropertyValue",
      "@id": "#yeast",
      "name": "3 g instant yeast"
    },
    {
      "@type": "PropertyValue",
      "@id": "#butter",
      "name": "60 g soft butter"
    },
    {
      "@type": "PropertyValue",
      "@id": "#frying-oil",
      "name": "Frying oil"
    },
    {
      "@type": "PropertyValue",
      "@id": "#cinnamon-sugar",
      "name": "Cinnamon sugar"
    }
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "name": "Mix",
      "text": [
        "Mix until no dry flour remains."
      ],
      "@id": "#mix",
      "flow:timing": "Day 1",
      "flow:inputs": [
        {
          "@id": "#bread-flour"
        },
        {
          "@id": "#starter"
        },
        {
          "@id": "#milk"
        },
        {
          "@id": "#eggs"
        },
        {
          "@id": "#sugar"
        },
        {
          "@id": "#salt"
        },
        {
          "@id": "#yeast"
        },
        {
          "@id": "#butter"
        }
      ],
      "flow:output": {
        "@id": "#mixed-dough"
      }
    },
    {
      "@type": "HowToStep",
      "name": "Rest",
      "text": [
        "Cover and rest."
      ],
      "@id": "#rest",
      "flow:timing": "Day 1 · 20 min",
      "flow:inputs": [
        {
          "@id": "#mixed-dough"
        }
      ],
      "flow:output": {
        "@id": "#rested-dough"
      }
    },
    {
      "@type": "HowToStep",
      "name": "Knead",
      "text": [
        "Knead until smooth, elastic and slightly tacky.",
        "Use little extra flour."
      ],
      "@id": "#knead",
      "flow:timing": "Day 1 · ~8 min",
      "flow:inputs": [
        {
          "@id": "#rested-dough"
        }
      ],
      "flow:output": {
        "@id": "#kneaded-dough"
      }
    },
    {
      "@type": "HowToStep",
      "name": "Ferment and chill",
      "text": [
        "Cover; ferment at room temperature 45–60 min.",
        "Refrigerate overnight."
      ],
      "@id": "#chill",
      "flow:timing": "Day 1",
      "flow:inputs": [
        {
          "@id": "#kneaded-dough"
        }
      ],
      "flow:output": {
        "@id": "#chilled-dough"
      }
    },
    {
      "@type": "HowToStep",
      "name": "Shape",
      "text": [
        "Divide into 15 pieces (62–65 g each).",
        "Cut rings, or join dough ropes into rings.",
        "Place on parchment squares; refrigerate."
      ],
      "@id": "#shape",
      "flow:timing": "Day 2",
      "flow:inputs": [
        {
          "@id": "#chilled-dough"
        }
      ],
      "flow:output": {
        "@id": "#shaped-doughnuts"
      }
    },
    {
      "@type": "HowToStep",
      "name": "Proof",
      "text": [
        "Remove from fridge.",
        "Proof at room temperature 2–3 h, until puffy but not fragile.",
        "Do not leave out overnight."
      ],
      "@id": "#proof",
      "flow:timing": "Day 2",
      "flow:inputs": [
        {
          "@id": "#shaped-doughnuts"
        }
      ],
      "flow:output": {
        "@id": "#proofed-doughnuts"
      }
    },
    {
      "@type": "HowToStep",
      "name": "Fry",
      "text": [
        "Heat oil to 175°C.",
        "Fry 1½–2 min on the first side, then ~1 min on the second."
      ],
      "@id": "#fry",
      "flow:timing": "Day 2",
      "flow:inputs": [
        {
          "@id": "#proofed-doughnuts"
        },
        {
          "@id": "#frying-oil"
        }
      ],
      "flow:output": {
        "@id": "#fried-doughnuts"
      }
    },
    {
      "@type": "HowToStep",
      "name": "Drain and toss",
      "text": [
        "Drain briefly.",
        "Toss warm doughnuts in cinnamon sugar."
      ],
      "@id": "#toss",
      "flow:inputs": [
        {
          "@id": "#fried-doughnuts"
        },
        {
          "@id": "#cinnamon-sugar"
        }
      ],
      "flow:output": {
        "@id": "#finished-doughnuts"
      }
    }
  ]
}
