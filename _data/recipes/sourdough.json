{
  "@context": [
    "https://schema.org",
    {
      "flow": "https://ashgillman.github.io/ns/recipe-flow#"
    }
  ],
  "@type": "Recipe",
  "name": "Sourdough regular loaf",
  "recipeIngredient": [
    {
      "@type": "PropertyValue",
      "@id": "#regular-flour",
      "name": "450 g regular flour"
    },
    {
      "@type": "PropertyValue",
      "@id": "#wholemeal-flour",
      "name": "50 g wholemeal flour"
    },
    {
      "@type": "PropertyValue",
      "@id": "#water",
      "name": "350 g water"
    },
    {
      "@type": "PropertyValue",
      "@id": "#starter",
      "name": "100 g sourdough starter"
    },
    {
      "@type": "PropertyValue",
      "@id": "#salt",
      "name": "20 g salt"
    }
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "name": "Mix and rest",
      "text": [
        "Mix flours, water and starter; rest."
      ],
      "@id": "#mix-rest",
      "flow:timing": "20 min",
      "flow:inputs": [
        {
          "@id": "#regular-flour"
        },
        {
          "@id": "#wholemeal-flour"
        },
        {
          "@id": "#water"
        },
        {
          "@id": "#starter"
        }
      ],
      "flow:output": {
        "@id": "#mixed-dough"
      }
    },
    {
      "@type": "HowToStep",
      "name": "Add salt",
      "text": [],
      "@id": "#add-salt",
      "flow:inputs": [
        {
          "@id": "#mixed-dough"
        },
        {
          "@id": "#salt"
        }
      ],
      "flow:output": {
        "@id": "#salted-dough"
      }
    },
    {
      "@type": "HowToStep",
      "name": "Stretch and fold",
      "text": [
        "Fold every 30 min."
      ],
      "@id": "#fold",
      "flow:timing": "First 2 h",
      "flow:inputs": [
        {
          "@id": "#salted-dough"
        }
      ],
      "flow:output": {
        "@id": "#folded-dough"
      }
    },
    {
      "@type": "HowToStep",
      "name": "Shape",
      "text": [],
      "@id": "#shape",
      "flow:inputs": [
        {
          "@id": "#folded-dough"
        }
      ],
      "flow:output": {
        "@id": "#shaped-dough"
      }
    },
    {
      "@type": "HowToStep",
      "name": "Refrigerate",
      "text": [],
      "@id": "#refrigerate",
      "flow:timing": "At least 16 h",
      "flow:inputs": [
        {
          "@id": "#shaped-dough"
        }
      ],
      "flow:output": {
        "@id": "#chilled-dough"
      }
    },
    {
      "@type": "HowToStep",
      "name": "Bake",
      "text": [
        "Bake at 250°C for 20 min, then 220°C until 95°C internally (~20 min)."
      ],
      "@id": "#bake",
      "flow:inputs": [
        {
          "@id": "#chilled-dough"
        }
      ],
      "flow:output": {
        "@id": "#loaf"
      }
    }
  ]
}
