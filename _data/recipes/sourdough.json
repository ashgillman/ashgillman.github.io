{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Sourdough regular loaf",
  "recipeIngredient": [
    "450 g regular flour",
    "50 g wholemeal flour",
    "350 g water",
    "100 g sourdough starter",
    "20 g salt"
  ],
  "recipeInstructions": [
    { "@type": "HowToStep", "name": "Mix and rest", "timing": "20 minutes", "text": ["Mix the flours, water and starter; leave to rest."] },
    { "@type": "HowToStep", "name": "Add salt", "text": [] },
    { "@type": "HowToStep", "name": "Stretch and fold", "timing": "First 2 hours", "text": ["Fold every 30 minutes."] },
    { "@type": "HowToStep", "name": "Shape", "text": [] },
    { "@type": "HowToStep", "name": "Refrigerate", "timing": "At least 16 hours", "text": [] },
    { "@type": "HowToStep", "name": "Bake", "text": ["250°C for 20 minutes, then 220°C until the internal temperature reaches 95°C (about 20 minutes)."] }
  ]
}
